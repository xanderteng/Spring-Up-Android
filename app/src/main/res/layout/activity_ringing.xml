<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_springup_sunrise"
    android:padding="20dp">

    <!-- Time -->
    <TextView
        android:id="@+id/tvRingingAlarmTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/text_primary"
        android:textSize="64sp"
        android:letterSpacing="-0.03"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="06:30" />

    <!-- Alarm title (small subtitle) -->
    <TextView
        android:id="@+id/tvRingingAlarmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRingingAlarmTime"
        tools:text="Morning Wake Up" />

    <!-- Stage Badge -->
    <TextView
        android:id="@+id/tvCurrentStageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_springup_mission_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/badge_mission_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRingingAlarmTitle"
        tools:text="STAGE 1 OF 2 · MATH" />

    <!-- Mission Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMissionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/tvMissionProgress"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentStageIndicator"
        app:strokeColor="@color/brand_red_border"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- 1. Math Mission -->
            <LinearLayout
                android:id="@+id/layoutMathMission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_mission_math"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Math mission"
                    app:tint="@color/brand_red" />

                <TextView
                    android:id="@+id/tvMathEquation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp"
                    tools:text="18 + 24 = ?" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxStrokeColor="@color/brand_red"
                    app:hintTextColor="@color/brand_red">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMathAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:hint="Your answer"
                        android:inputType="numberSigned"
                        android:textColor="@color/black"
                        android:textColorHint="@color/text_secondary"
                        android:textStyle="bold"
                        android:textSize="28sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitMath"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/brand_red"
                    android:fontFamily="sans-serif-black"
                    android:text="SUBMIT"
                    android:textSize="15sp"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- 2. Shake Mission -->
            <LinearLayout
                android:id="@+id/layoutShakeMission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_mission_shake"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Shake mission"
                    app:tint="@color/brand_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHAKE YOUR PHONE!"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/brand_red"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvShakeCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="56sp"
                    tools:text="25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="shakes remaining"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressShake"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="24dp"
                    app:indicatorColor="@color/brand_red"
                    app:trackColor="@color/brand_red_light"
                    app:trackCornerRadius="5dp" />
            </LinearLayout>

            <!-- 3. Barcode / QR Mission (Embedded Live Camera View) -->
            <FrameLayout
                android:id="@+id/layoutBarcodeMission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <!-- Embedded Live Camera Viewfinder -->
                <com.journeyapps.barcodescanner.CompoundBarcodeView
                    android:id="@+id/ringingBarcodeScannerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Overlay Header & Target Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:background="#AA000000"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POINT CAMERA AT BARCODE"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/pure_white"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvTargetBarcodeDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Target: 8992753123456"
                        android:textColor="@color/brand_red_border"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bottom Bar: Flash Toggle + Manual Entry Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#AA000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <ImageButton
                        android:id="@+id/btnRingingToggleFlash"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Flashlight"
                        android:src="@drawable/ic_flash_on"
                        app:tint="@color/pure_white" />

                    <TextView
                        android:id="@+id/btnToggleManualBarcode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:paddingEnd="8dp"
                        android:text="Type manually"
                        android:textColor="@color/pure_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Manual Entry Fallback Layer -->
                <LinearLayout
                    android:id="@+id/layoutManualBarcodeEntry"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/card_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manual Barcode Entry"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:boxStrokeColor="@color/brand_red"
                        app:hintTextColor="@color/brand_red">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBarcodeAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hint="Barcode or QR digits"
                            android:inputType="textCapCharacters"
                            android:textColor="@color/black"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitBarcode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/brand_red"
                        android:fontFamily="sans-serif-black"
                        android:text="VERIFY CODE"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackToCamera"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/surface_background"
                        android:text="BACK TO CAMERA"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </FrameLayout>

            <!-- 0. No Mission (0 Missions configured) -->
            <LinearLayout
                android:id="@+id/layoutNoMission"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_mission_success"
                    android:layout_marginBottom="16dp"
                    android:contentDescription="Wake up"
                    app:tint="@color/brand_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME TO WAKE UP!"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDismissAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/brand_red"
                    android:fontFamily="sans-serif-black"
                    android:text="DISMISS ALARM"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sub-progress -->
    <TextView
        android:id="@+id/tvMissionProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/btnSnooze"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Problem 1 of 3" />

    <!-- Snooze -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/card_background"
        android:text="SNOOZE 5M (3 LEFT)"
        android:textColor="@color/brand_red"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:strokeColor="@color/brand_red"
        app:strokeWidth="1.5dp" />

</androidx.constraintlayout.widget.ConstraintLayout>